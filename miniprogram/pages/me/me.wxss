.cal { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.cell { width: 72rpx; height: 72rpx; margin: 8rpx; border-radius: 50%; border: 2rpx dashed var(--wash-2);
  color: var(--text-3); font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.cell.on { border: 4rpx solid var(--ink); color: var(--ink); font-weight: 700; transform: rotate(-8deg);
  font-family: "Songti SC", "Noto Serif SC", "STSong", serif; }
