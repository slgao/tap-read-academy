<view class="brand">
  <image class="logo" src="/images/logo.png" mode="aspectFit" />
  <view class="name serif">福斯特培训学校</view>
  <view class="en-name">FIRST TRAINING SCHOOL</view>
  <view class="tag">点读课文 · 完成作业 · 每日打卡</view>
</view>
<view class="card">
  <view class="muted small">姓名</view>
  <input class="inp" value="{{name}}" bindinput="onName" placeholder="例如：李小明"/>
  <view class="muted small" style="margin-top:24rpx">班级邀请码</view>
  <input class="inp" value="{{code}}" bindinput="onCode" placeholder="向老师要 6 位邀请码"/>
  <view class="btn" style="margin-top:36rpx" hover-class="button-hover" bindtap="login">进入学习</view>
</view>
<view class="muted small" style="text-align:center">演示：李小明 / 邀请码 DEMO88</view>
