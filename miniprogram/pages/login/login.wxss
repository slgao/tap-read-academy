.brand { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 48rpx; }
.logo { width: 220rpx; height: 220rpx; }
.name { font-size: 44rpx; font-weight: 700; color: var(--ink-deep); margin-top: 28rpx; letter-spacing: 8rpx; }
.en-name { font-size: 21rpx; color: var(--text-3); letter-spacing: 6rpx; margin-top: 4rpx; }
.tag { font-size: 26rpx; color: var(--text-2); margin-top: 24rpx; }
.inp { border: 2rpx solid var(--line); border-radius: 20rpx; padding: 20rpx 24rpx; margin-top: 12rpx; height: 44rpx; }
