.reader { height: calc(100vh - 260rpx); background: #F6F5FA; }
.pagewrap { position: relative; width: 100%; background: #fff; }
.pageimg { width: 100%; display: block; }
.hs { position: absolute; border-radius: 12rpx; border: 4rpx solid transparent; }
.hs.show { border: 2rpx dashed rgba(43,26,110,.45); }
.hs.hw { box-shadow: inset 0 0 0 2rpx rgba(43,26,110,.55); }
.hs.active { background: rgba(43,26,110,.12); border: 4rpx solid var(--ink); }
.playbar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 2rpx solid var(--line);
  padding: 22rpx 32rpx 34rpx; }
.sub-en { font-family: Georgia, "Times New Roman", serif; font-size: 32rpx; color: var(--ink-deep); min-height: 44rpx; }
.sub-cn { font-size: 24rpx; color: var(--text-2); min-height: 34rpx; margin-bottom: 18rpx; }
.ic { width: 76rpx; height: 76rpx; border-radius: 50%; border: 2rpx solid var(--line); background: #fff; color: var(--text-2);
  font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-left: 12rpx; }
.ic.on { border-color: var(--ink); color: var(--ink); background: var(--wash); }
.ic.rec { border-color: var(--ink); color: var(--ink); }
.ic.rec.recording { background: var(--danger); border-color: var(--danger); color: #fff; }
.ic.playing { background: var(--ink); border-color: var(--ink); color: #fff; }
