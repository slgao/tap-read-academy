.reader { height: calc(100vh - 260rpx); background:#EDF1F5; }
.pagewrap { position: relative; width: 100%; }
.pageimg { width: 100%; display: block; }
.hs { position: absolute; border-radius: 14rpx; border: 4rpx solid transparent; }
.hs.show { background: rgba(245,158,11,.10); border-color: rgba(245,158,11,.45); }
.hs.hw { box-shadow: inset 0 0 0 4rpx rgba(245,158,11,.75); }
.hs.active { background: rgba(14,165,233,.22); border-color: #0EA5E9; }
.playbar { position: fixed; left:0; right:0; bottom:0; background:#fff; border-top:2rpx solid #E8EDF3;
  padding: 20rpx 28rpx 32rpx; }
.sub-en { font-size: 30rpx; font-weight: 600; min-height: 42rpx; }
.sub-cn { font-size: 24rpx; color:#94A3B8; min-height: 34rpx; margin-bottom: 16rpx; }
.ic { width:76rpx; height:76rpx; border-radius:20rpx; background:#EEF2F6; color:#475569; font-size:32rpx;
  display:flex; align-items:center; justify-content:center; margin-left:12rpx; }
.ic.on { background:#E0F2FE; color:#0284C7; }
.ic.rec { background:#FEE2E2; color:#DC2626; }
.ic.rec.recording { background:#DC2626; color:#fff; }
