<view class="hero">
  <view class="title">{{greeting}}，{{user.name}}</view>
  <view class="muted small">{{sum.checkedInToday ? '今天的印已经盖上了' : '今天读满 ' + needMin + ' 分钟，就能盖上今天的印'}}</view>
  <view class="seal-row">
    <view wx:for="{{seals}}" wx:key="key" class="seal-cell">
      <view class="seal {{item.on ? 'on' : ''}} {{item.today ? 'today' : ''}}">{{item.on ? '读' : ''}}</view>
      <text>{{item.label}}</text>
    </view>
  </view>
  <view class="stats">
    <view class="stat"><view class="num">{{sum.streak}}</view><view class="lbl">连续打卡天数</view></view>
    <view class="stat"><view class="num">{{sum.stars}}</view><view class="lbl">星星</view></view>
    <view class="stat"><view class="num">{{todayMin}}</view><view class="lbl">今天读了几分钟</view></view>
  </view>
</view>

<view class="card">
  <view class="row between"><text class="section-title">今日作业</text>
    <text class="pill {{todo.length ? 'todo' : 'ok'}}">{{todo.length ? todo.length + ' 项待完成' : '全部完成'}}</text></view>
  <view wx:for="{{todo}}" wx:key="id" class="row item" bindtap="openHw" data-id="{{item.id}}">
    <view class="num-dot">{{index + 1}}</view>
    <view class="grow"><view class="strong ellip">{{item.title}}</view>
      <view class="muted small">{{item.itemCount}} 句 · {{item.className}}</view></view>
    <text class="muted">›</text>
  </view>
  <view wx:if="{{!todo.length}}" class="muted small" style="margin-top:16rpx">老师还没有布置新作业</view>
</view>

<view class="card">
  <view class="section-title">教材</view>
  <view wx:for="{{books}}" wx:key="id" class="row item" bindtap="openBook" data-id="{{item.id}}">
    <view class="cv serif">{{item.initial}}</view>
    <view class="grow"><view class="strong ellip">{{item.title}}</view>
      <view class="muted small">{{item.lessonCount}} 课 · {{item.pageCount}} 页</view></view>
    <text class="muted">›</text>
  </view>
</view>
