<view class="hero">
  <view style="font-size:38rpx;font-weight:600">你好，{{user.name}}</view>
<view class="small" style="opacity:.9">{{sum.checkedInToday ?'今天已打卡，继续保持' :'今天还没打卡，读 1 分钟就能打卡'}}</view>
  <view class="row" style="margin-top:28rpx">
    <view style="margin-right:48rpx"><view style="font-size:44rpx;font-weight:700">{{sum.streak}}</view><view style="font-size:22rpx;opacity:.85">连续打卡(天)</view></view>
    <view style="margin-right:48rpx"><view style="font-size:44rpx;font-weight:700">{{sum.stars}}</view><view style="font-size:22rpx;opacity:.85">累计星星</view></view>
    <view><view style="font-size:44rpx;font-weight:700">{{todayMin}}</view><view style="font-size:22rpx;opacity:.85">今日(分钟)</view></view>
  </view>
</view>

<view class="card">
  <view class="row between"><text class="strong">今日作业</text>
    <text class="pill {{todo.length ? 'todo' : 'ok'}}">{{todo.length ? todo.length + ' 项待完成' : '全部完成'}}</text></view>
  <view wx:for="{{todo}}" wx:key="id" class="row item" bindtap="openHw" data-id="{{item.id}}">
    <view class="grow"><view class="strong ellip">{{item.title}}</view>
      <view class="muted small">{{item.itemCount}} 句 · {{item.className}}</view></view>
    <text class="muted">›</text>
  </view>
  <view wx:if="{{!todo.length}}" class="muted small" style="margin-top:16rpx">老师还没有布置新作业</view>
</view>

<view class="card">
  <view class="strong">教材</view>
  <view wx:for="{{books}}" wx:key="id" class="row item" bindtap="openBook" data-id="{{item.id}}">
  <view class="cv">{{item.initial}}</view>
    <view class="grow"><view class="strong ellip">{{item.title}}</view>
      <view class="muted small">{{item.lessonCount}} 课 · {{item.pageCount}} 页</view></view>
    <text class="muted">›</text>
  </view>
</view>
