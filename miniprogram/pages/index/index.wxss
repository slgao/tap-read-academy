.item { padding: 24rpx 0; border-top: 2rpx solid var(--line); margin-top: 16rpx; }
.num-dot { width: 52rpx; height: 52rpx; border-radius: 50%; border: 2rpx solid var(--ink); color: var(--ink);
  font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.cv { width: 84rpx; height: 108rpx; border-radius: 8rpx 16rpx 16rpx 8rpx; background: var(--wash);
  border-left: 6rpx solid var(--ink); display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 700; color: var(--ink); margin-right: 24rpx; }
